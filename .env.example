# Core
NODE_ENV=development

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d

# Database (host port 5433 maps to container 5432 to avoid clashes)
DATABASE_URL=postgresql://costopt:costopt@localhost:5433/costopt?schema=public

# Redis / queue
REDIS_URL=redis://localhost:6379

# Uploads (local dev)
UPLOAD_DIR=./uploads
